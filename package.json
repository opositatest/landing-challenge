{
  "name": "landing-challenge",
  "version": "0.0.1",
  "description": "Design System OPO - Component Library",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "unpkg": "dist/landing-challenge/landing-challenge.esm.js",
  "type": "module",
  "scripts": {
    "icons:format": "find src/components/opo-icon/raw-icons -name '*.svg' -exec sh -c 'xmllint --format \"$1\" > /tmp/fmt.svg && mv /tmp/fmt.svg \"$1\"' sh {} ;",
    "icons:optimize:ui": "svgo --config src/components/opo-icon/scripts/svgo.config.ui.js -f src/components/opo-icon/raw-icons/ui --multipass",
    "icons:optimize:brand": "svgo --config src/components/opo-icon/scripts/svgo.config.brand.js -f src/components/opo-icon/raw-icons/brand --multipass",
    "icons:optimize": "npm run icons:format && npm run icons:optimize:ui && npm run icons:optimize:brand",
    "icons:build": "node src/components/opo-icon/scripts/generate-icon-sprite.js",
    "icons:watch": "npm run icons:build && nodemon --watch src/components/opo-icon/raw-icons -e svg --exec \"npm run icons:build\"",
    "build": "stencil build && npm run icons:build",
    "dev:lib": "stencil build --watch --docs --log-level=info",
    "prestorybook": "npm run build",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:dev": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "landing:dev": "npm run icons:build && vite --config landing/vite.config.ts --host 0.0.0.0 --port 3333",
    "landing:build": "npm run icons:build && vite build --config landing/vite.config.ts",
    "dev": "npm run dev:ordered",
    "dev:ordered": "npm run build && concurrently -k -n STENCIL,ICONS,SB \"npm run dev:lib\" \"npm run icons:watch\" \"npm run storybook:dev\"",
    "dev:reset": "pkill -f storybook || true && pkill -f concurrently || true && pkill -f \"stencil build --watch\" || true && lsof -ti:6006 | xargs kill -9 2>/dev/null || true",
    "dev:fresh": "npm run dev:reset && npm run dev:ordered",
    "clean": "rimraf dist www loader",
    "prebuild-storybook": "npm run clean && npm run build",
    "lint": "npm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "generate": "stencil generate",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "loader/",
    "public/icons"
  ],
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@stencil/core": "^4.27.1",
    "@stencil/vitest": "^1.8.3",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/web-components-vite": "^10.3.6",
    "@types/node": "^25.5.0",
    "@vitest/browser-playwright": "^4.0.0",
    "@vitest/ui": "^4.1.2",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "lit": "^3.3.3",
    "nodemon": "latest",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "storybook": "^10.3.6",
    "storybook-addon-pseudo-states": "^10.3.6",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "svg-sprite": "^2.0.4",
    "svgo": "^4.0.0",
    "vite": "^8.0.12",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
