{
  "name": "landing-challenge",
  "version": "0.0.1",
  "description": "Lit and Web Components challenge starter with a single opo-button component",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:opositatest/landing-challenge.git"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "vite build && vite build --config landing/vite.config.ts",
    "start": "vite --config landing/vite.config.ts --host 0.0.0.0 --port 3333",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/web-components-vite": "^10.3.3",
    "@types/node": "^25.5.0",
    "jsdom": "^29.0.1",
    "lit": "^3.3.1",
    "storybook": "^10.3.3",
    "vite": "^8.0.3",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
